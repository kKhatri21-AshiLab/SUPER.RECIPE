<!--
    ==========================================
    RECIPE SHOWCASE PAGE - RECEPE CARD.HTML
    ==========================================

    PURPOSE:
    Interactive recipe showcase website featuring 9 recipe cards with modal details popup.

    FEATURES:
    - Responsive grid layout with recipe cards
    - Hover animations and visual effects
    - Square modal popup for detailed recipe view
    - Login button linking to separate login page
    - Mobile-responsive design
    - Smooth card entrance animations

    STRUCTURE:
    - HTML5 semantic structure
    - CSS3 with gradients, animations, and responsive design
    - Vanilla JavaScript for modal functionality
    - Font Awesome icons
    - Unsplash images for recipe photos

    DEPENDENCIES:
    - Font Awesome CDN for icons
    - Unsplash API for recipe images

    AUTHOR: Recipe Showcase Application
    VERSION: 1.0
    LAST UPDATED: April 6, 2026
-->
<!DOCTYPE html>
<!-- Recipe Showcase Page - Interactive recipe cards with modal details -->
<html lang="en">
<head>
    <!-- SHARED NAVIGATION -->
    <link rel="stylesheet" href="styles/shared-nav.css">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dataset Recipe Showcase</title>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- PapaParse for CSV parsing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

   
</head>
<body>
    <!-- Login Button - Links to login page -->
    <a href="LOGIN PAGE.HTML" class="login-btn">
        <i class="fas fa-sign-in-alt"></i> Login
    </a>

    <!-- Main Container -->
    <div class="container">
        <!-- Search -->
        <div style="text-align: center; margin-bottom: 20px;">
            <input type="text" id="searchInput" placeholder="Search recipes..." style="padding: 12px 20px; width: 400px; max-width: 100%; border: 2px solid rgba(255,255,255,0.3); border-radius: 25px; font-size: 16px; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px);">
        </div>
        <!-- Recipe Cards Grid -->
        <div class="recipes-grid" id="recipesGrid">
            <div class="recipe-status" id="recipeStatus">Loading recipes from dataset...</div>
        </div>
    </div>


    <a href="ADD RECIPE PAGE.HTML" class="add-recipe-btn" title="Add Recipe">
        <i class="fas fa-plus"></i>
    </a>

    <!-- Modal Popup for Detailed Recipe View -->
    <div id="recipeModal" class="modal">
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal()">&times;</span>
            <div id="modalRecipeContent"></div>
        </div>
    </div>

  
</body>
</html>

